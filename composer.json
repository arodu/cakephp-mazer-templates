{
    "name": "arodu/cakephp-mazer",
    "description": "Mazer plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.1",
        "arodu/cakephp-bootstrap-tools": "dev-2.x-dev",
        "cakephp/cakephp": "^5.0.1",
        "friendsofcake/bootstrap-ui": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1"
    },
    "autoload": {
        "psr-4": {
            "Mazer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mazer\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    }
}
