{
    "name": "arodu/cakephp-mazer",
    "description": "Mazer plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.1",
        "arodu/cakephp-bootstrap-tools": "^2.0",
        "cakephp/cakephp": "^5.0.1",
        "friendsofcake/bootstrap-ui": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1"
    },
    "extra": {
        "theme-config": {
            "github_repo": "https://github.com/zuramai/mazer",
            "tag": "v2.3.0",
            "release_asset": "template.zip", 
            "source_dir": "dist", 
            "dest_dir": "webroot/mazer"
        
        }
    },
    "autoload": {
        "psr-4": {
            "Mazer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mazer\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "scripts": {
        "update-theme": "bin/update-assets"
    }
}