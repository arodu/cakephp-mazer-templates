{
    "name": "arodu/cakephp-mazer",
    "description": "MazerTemplates plugin for CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "arodu/cakephp-bootstrap-tools": "dev-2.next-cake5",
        "cakephp/cakephp": "^5.0.1",
        "friendsofcake/bootstrap-ui": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1"
    },
    "autoload": {
        "psr-4": {
            "MazerTemplates\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "git",
            "url": "git@github.com:arodu/cakephp-bs-utils.git"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "MazerTemplates\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    }
}
