<?php
/**
 * @var \{{ namespace }}\View\AppView $this
 * @var \{{ entityClass }} ${{ singularVar }}
 */

$this->assign('title', __('{{ pluralHumanName }}'));
$this->Breadcrumbs->add([
    ['title' => __('Home'), 'url' => '/'],
    ['title' => __('List {{ pluralHumanName }}'), 'url' => ['action' => 'index']],
    ['title' => __('View {{ singularHumanName }}')],
]);
?>
{% set associations = {'BelongsTo': [], 'HasOne': [], 'HasMany': [], 'BelongsToMany': []}|merge(associations) %}
{% set fieldsData = Bake.getViewFieldsData(fields, schema, associations) %}
{% set associationFields = fieldsData.associationFields %}
{% set groupedFields = fieldsData.groupedFields %}
{% set pK = '$' ~ singularVar ~ '->' ~ primaryKey[0] %}
<div class="card view {{ pluralVar }}">
    <div class="card-header d-flex">
        <h4 class="card-title">
            <?= $this->Html->link('<i class="bi bi-caret-left-fill"></i>', $redirect ?? ['action' => 'index'], ['escape' => false]) ?>
            <?= __('View {{ singularHumanName }}: {0}', h(${{ singularVar }}->{{ displayField }})) ?>
        </h4>
        <div class="ms-auto d-flex gap-1">
            <?= $this->Html->link(
                __('List {{ pluralHumanName }}'),
                ['action' => 'index', '?' => ['redirect' => $this->getRequest()->getPath()]],
                ['class' => 'btn btn-light btn-sm']
            ) ?>
            <?= $this->Html->link(
                __('Edit {{ singularHumanName }}'),
                ['action' => 'edit', {{ pK|raw }}, '?' => ['redirect' => $this->getRequest()->getPath()]],
                ['class' => 'btn btn-warning btn-sm']
            ) ?>
            <?= $this->Form->postLink(
                __('Delete {{ singularHumanName }}'),
                ['action' => 'delete', {{ pK|raw }}],
                ['confirm' => __('Are you sure you want to delete {0}?', ${{ singularVar }}->{{ displayField }}), 'class' => 'btn btn-danger btn-sm']
            ) ?>
            <?= $this->Html->link(
                __('Add {{ singularHumanName }}'),
                ['action' => 'add', '?' => ['redirect' => $this->getRequest()->getPath()]],
                ['class' => 'btn btn-success btn-sm']
            ) ?>
        </div>
    </div>
    <div class="card-body">
        <table class="table table-hover">
{% if groupedFields['string'] %}
{% for field in groupedFields['string'] %}
{% if associationFields[field] is defined %}
{% set details = associationFields[field] %}
            <tr>
                <th><?= __('{{ details.property|humanize }}') ?></th>
                <td><?= ${{ singularVar }}->hasValue('{{ details.property }}') ? $this->Html->link(${{ singularVar }}->{{ details.property }}->{{ details.displayField }}, ['controller' => '{{ details.controller }}', 'action' => 'view', ${{ singularVar }}->{{ details.property }}->{{ details.primaryKey[0] }}]) : '' ?></td>
            </tr>
{% else %}
            <tr>
                <th><?= __('{{ field|humanize }}') ?></th>
                <td><?= h(${{ singularVar }}->{{ field }}) ?></td>
            </tr>
{% endif %}
{% endfor %}
{% endif %}
{% if associations.HasOne %}
{% for alias, details in associations.HasOne %}
            <tr>
                <th><?= __('{{ alias|underscore|singularize|humanize }}') ?></th>
                <td><?= ${{ singularVar }}->hasValue('{{ details.property }}') ? $this->Html->link(${{ singularVar }}->{{ details.property }}->{{ details.displayField }}, ['controller' => '{{ details.controller }}', 'action' => 'view', ${{ singularVar }}->{{ details.property }}->{{ details.primaryKey[0] }}]) : '' ?></td>
            </tr>
{% endfor %}
{% endif %}
{% if groupedFields.number %}
{% for field in groupedFields.number %}
            <tr>
                <th><?= __('{{ field|humanize }}') ?></th>
{% set columnData = Bake.columnData(field, schema) %}
{% if columnData.null %}
                <td><?= ${{ singularVar }}->{{ field }} === null ? '' : $this->Number->format(${{ singularVar }}->{{ field }}) ?></td>
{% else %}
                <td><?= $this->Number->format(${{ singularVar }}->{{ field }}) ?></td>
{% endif %}
            </tr>
{% endfor %}
{% endif %}
{% if groupedFields.enum %}
{% for field in groupedFields.enum %}
            <tr>
                <th><?= __('{{ field|humanize }}') ?></th>
{% set columnData = Bake.columnData(field, schema) %}
{% if columnData.null %}
            <td><?= ${{ singularVar }}->{{ field }} === null ? '' : h(${{ singularVar }}->{{ field }}->label()) ?></td>
{% else %}
            <td><?= h(${{ singularVar }}->{{ field }}->label()) ?></td>
{% endif %}
            </tr>
{% endfor %}
{% endif %}
{% if groupedFields.date %}
{% for field in groupedFields.date %}
            <tr>
                <th><?= __('{{ field|humanize }}') ?></th>
                <td><?= h(${{ singularVar }}->{{ field }}) ?></td>
            </tr>
{% endfor %}
{% endif %}
{% if groupedFields.boolean %}
{% for field in groupedFields.boolean %}
            <tr>
                <th><?= __('{{ field|humanize }}') ?></th>
                <td><?= ${{ singularVar }}->{{ field }} ? __('Yes') : __('No') ?></td>
            </tr>
{% endfor %}
{% endif %}
        </table>
{% if groupedFields.text %}
{% for field in groupedFields.text %}
        <div class="row">
            <div class="col-12">
                <strong><?= __('{{ field|humanize }}') ?></strong>
                <blockquote>
                    <?= $this->Text->autoParagraph(h(${{ singularVar }}->{{ field }})); ?>
                </blockquote>
            </div>
        </div>
{% endfor %}
{% endif %}
    </div>
</div>
{% set relations = associations.BelongsToMany|merge(associations.HasMany) %}
{% for alias, details in relations %}
{% set otherSingularVar = alias|singularize|variable %}
{% set otherPluralHumanName = details.controller|underscore|humanize %}
{% set otherSingularHumanName = alias|singularize|underscore|humanize %}

<div class="card related {{ pluralVar }} {{ alias|underscore }}">
    <div class="card-header d-flex">
        <h4 class="card-title" id="related-{{ alias|underscore }}">
            <?= __('Related {{ otherPluralHumanName }}') ?>
        </h4>
        <div class="ms-auto d-flex gap-1">
            <?= $this->Html->link(
                __('Add {{ otherSingularHumanName }}'),
                [
                    'controller' => '{{ details.controller }}',
                    'action' => 'add',
                    '?' => [
                        '{{ singularVar }}_id' => ${{ singularVar }}->{{ primaryKey[0] }},
                        'redirect' => $this->getRequest()->getPath() . '#related-{{ alias|underscore }}',
                    ],
                ],
                ['class' => 'btn btn-success btn-sm']
            ) ?>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <tr>
    {% for field in details.fields %}
                    <th><?= __('{{ field|humanize }}') ?></th>
    {% endfor %}
                    <th class="actions"><?= __('Actions') ?></th>
                </tr>
                <?php if (empty(${{ singularVar }}->{{ details.property }})) : ?>
                    <tr>
                        <td colspan="{{ details.fields|length + 1 }}" class="text-muted text-center">
                            <?= __('No {{ otherPluralHumanName }} found') ?>
                        </td>
                    </tr>
                <?php else: ?>
                    <?php foreach (${{ singularVar }}->{{ details.property }} as ${{ otherSingularVar }}) : ?>
                        <tr>
{% for field in details.fields %}
                            <td><?= h(${{ otherSingularVar }}->{{ field }}) ?></td>
{% endfor %}
{% set otherPk = '$' ~ otherSingularVar ~ '->' ~ details.primaryKey[0] %}
                            <td class="actions">
                                <?= $this->Html->link(
                                    __('View'),
                                    [
                                        'controller' => '{{ details.controller }}',
                                        'action' => 'view',
                                        {{ otherPk|raw }},
                                        '?' => ['redirect' => $this->getRequest()->getPath() . '#related-{{ alias|underscore }}'],
                                    ],
                                    ['class' => 'btn btn-info btn-sm']    
                                ) ?>
                                <?= $this->Html->link(
                                    __('Edit'),
                                    [
                                        'controller' => '{{ details.controller }}',
                                        'action' => 'edit',
                                        {{ otherPk|raw }},
                                        '?' => ['redirect' => $this->getRequest()->getPath() . '#related-{{ alias|underscore }}'],
                                    ],
                                    ['class' => 'btn btn-warning btn-sm']
                                ) ?>
                                <?= $this->Form->postLink(
                                    __('Delete'),
                                    [
                                        'controller' => '{{ details.controller }}',
                                        'action' => 'delete',
                                        {{ otherPk|raw }},
                                        '?' => ['redirect' => $this->getRequest()->getPath() . '#related-{{ alias|underscore }}'],
                                    ],
                                    ['confirm' => __('Are you sure you want to delete # {0}?', {{ otherPk|raw }}), 'class' => 'btn btn-danger btn-sm']
                                ) ?>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                <?php endif; ?>
            </table>
        </div>
    </div>
</div>
{% endfor %}    


